# ── RAG 金融问答系统 部署变量 ──
# 复制本文件为 .env 并按需修改（compose 自动读取同目录 .env）

# 宿主机 BGE-M3 模型目录（只读挂载到容器 /models/bge-m3）
# Windows 路径用正斜杠；含中文路径 Docker Desktop 支持，但若挂载失败可先把模型拷到纯英文路径
MODEL_PATH=F:/4--专业所有安装的软件及改动设置/2-6--专高6/bge-m3

# 对外暴露端口（浏览器/接口访问）
APP_PORT=8010

# LLM 密钥（覆盖 config.docker.json，避免密钥写死在镜像/配置）
APP_LLM_API_KEY=sk-2c7be8b46e41438fa0547fd5736a9636

# 检索模式：fulltext（默认，最稳，纯 BM25，Milvus 空也可跑） / vector / hybrid
APP_RETRIEVAL_MODE=fulltext
