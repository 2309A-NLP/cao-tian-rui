# 复制此文件为 .env 并填入真实值，.env 不会上传到 GitHub
# Copy this file to .env and fill in your real values

# 硅基流动 API Key（https://cloud.siliconflow.cn/）
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 硅基流动 API 地址（默认不用改）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# NL2SQL 使用的模型（推荐大参数模型，准确率更高）
NL2SQL_MODEL=Qwen/Qwen2.5-72B-Instruct

# 生成回答使用的模型
ANSWER_MODEL=Qwen/Qwen2.5-72B-Instruct

# SQLite 数据库路径（相对或绝对路径均可）
DB_PATH=./data/博金杯比赛数据.db

# 问题文件路径
QUESTION_FILE=./question.jsonl

# 输出结果路径
OUTPUT_FILE=./outputs/answers.jsonl

# SQL 执行失败最大重试次数
MAX_RETRY=3

# 批量处理时每次请求间隔（秒），避免触发限流
REQUEST_INTERVAL=0.5
